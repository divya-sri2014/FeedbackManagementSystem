@model FeedbackManagementSystem.Models.Feedback

@{
    ViewData["Title"] = "Submit Feedback";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="mb-4">
            <h1 class="fw-bold">Share Your Feedback</h1>
            <p class="text-muted">
                Please complete the form below.
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                @await Html.PartialAsync("_FeedbackForm", Model)

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}