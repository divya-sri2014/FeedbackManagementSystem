@model IEnumerable<FeedbackManagementSystem.Models.Feedback>

@{
    ViewData["Title"] = "Feedback Records";
}

<div class="d-flex justify-content-between
    align-items-center flex-wrap gap-3 mb-4">

    <div>
        <h1 class="fw-bold">Feedback Management</h1>
        <p class="text-muted mb-0">
            View and manage submitted feedback.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Submit New Feedback
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h5>No feedback available</h5>

            <p class="text-muted">
                Submit the first feedback record.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Submit Feedback
            </a>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover
            align-middle bg-white">

            <thead class="table-primary">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Rating</th>
                    <th>Comments</th>
                    <th>Date Submitted</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Rating / 5</td>
                        <td class="text-break">
                            @item.Comments
                        </td>
                        <td>
                            @item.DateSubmitted.ToString(
                                "dd MMM yyyy, hh:mm tt")
                        </td>
                        <td>
                            <form asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  onsubmit="return confirm(
                                'Delete this feedback?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm
                                    btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}